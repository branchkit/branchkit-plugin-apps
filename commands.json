[
  {
    "pattern": [["focus", "switch"], "<apps>"],
    "action": { "type": "apps.launch", "params": { "app_id": "{apps}" } },
    "category": "Applications",
    "description": "Switch to a named app, opening it if it isn't running."
  },
  {
    "pattern": [["focus", "switch"], "to", "<apps>"],
    "action": { "type": "apps.launch", "params": { "app_id": "{apps}" } },
    "category": "Applications",
    "description": "Switch to a named app, opening it if it isn't running."
  },
  {
    "pattern": ["new", "<apps>"],
    "action": { "type": "apps.new_window", "params": { "app_id": "{apps}" } },
    "category": "Applications",
    "description": "Open a new window of the app on this desktop, without switching to the desktop its other windows are on."
  }
]
